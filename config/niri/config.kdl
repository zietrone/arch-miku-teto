// ┌─────────────────────────────────────────────┐
// │  niri · Miku 01  ♪                          │
// │  colors/binds/gaps live in dms/*.kdl        │
// │  (edit those via DMS settings: Mod+Comma)   │
// │  docs: https://github.com/YaLTeR/niri/wiki  │
// └─────────────────────────────────────────────┘

// ── General ────────────────────────────────────
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

config-notification { disable-failed; }
hotkey-overlay { skip-at-startup; }
gestures {
    hot-corners { off; }
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    XCURSOR_THEME "miku-cursor-linux"
    XCURSOR_SIZE "24"
}

cursor {
    xcursor-theme "miku-cursor-linux"
    xcursor-size 24
}

// ── Input ──────────────────────────────────────
input {
    keyboard {
        xkb { }  // empty = use localectl settings
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}

// ── Layout ─────────────────────────────────────
layout {
    background-color "transparent"
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    border { off; }

    // soft teal glow under windows (color comes from dms/colors.kdl)
    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=5
    }
}

overview {
    workspace-shadow { off; }
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

// ── Animations ─────────────────────────────────
animations {
    workspace-switch          { spring damping-ratio=0.80 stiffness=523 epsilon=0.0001; }
    horizontal-view-movement  { spring damping-ratio=0.85 stiffness=423 epsilon=0.0001; }
    window-movement           { spring damping-ratio=0.75 stiffness=323 epsilon=0.0001; }
    window-resize             { spring damping-ratio=0.85 stiffness=423 epsilon=0.0001; }
    overview-open-close       { spring damping-ratio=0.85 stiffness=800 epsilon=0.0001; }
    config-notification-open-close { spring damping-ratio=0.65 stiffness=923 epsilon=0.001; }
    window-open        { duration-ms 150; curve "ease-out-expo"; }
    window-close       { duration-ms 150; curve "ease-out-quad"; }
    screenshot-ui-open { duration-ms 200; curve "ease-out-quad"; }
}

// ── Window rules ───────────────────────────────
// WezTerm initial-configure workaround
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

// Floating utilities
window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^xdg-desktop-portal$"#
    match app-id=r#"org\.quickshell$"#
    match app-id=r#"^com\.danklinux\.dms$"#
    match app-id="zoom"
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Settings panels tile at half width
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}

// Steam toasts in the corner, don't steal focus
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

// ── Keybinds (extra; main set in dms/binds.kdl) ─
recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

debug {
    honor-xdg-activation-with-invalid-serial
}

// ── DankMaterialShell (auto-generated) ─────────
include "dms/colors.kdl"
include "dms/layout.kdl"
include "dms/input.kdl"
include "dms/alttab.kdl"
include "dms/binds.kdl"
include "dms/outputs.kdl"
include "dms/cursor.kdl"
include "dms/windowrules.kdl"
include "dms/wpblur.kdl"

#!/usr/bin/env python3
"""Render the mini Miku prompt sprite (chibi Miku with a leek, modelled on the
pixel art in ~/Downloads/Terminalart.webp, recoloured to the Miku palette) as a
PNG sized to exactly fit a block of terminal cells, so kitty never rescales it.

usage: mini-miku-png CELL_W CELL_H ROWS OUT.png [miku|teto]   -> prints the number of cells it spans
teto draws Kasane Teto instead: coiled red drill twintails and a baguette.
"""
import math, sys
from PIL import Image

# 36x38, drawn at an integer scale. '.' = transparent
SPRITE = [
    "......................kkk...........",
    ".....................kkRkkk.........",
    ".....................kkkRRk.........",
    ".......kkk...........kkDRRk.........",
    "......kkRkkkkkkkkkkkkkkDRRkk........",
    ".....kHkkRkkHHHHHHHHHHHHTDkkk.......",
    "...kTHHHkkRRkHHHHHHHHHHHHHDHk.......",
    "...kTHHHkRkkHHHHHHHHHHHHHHHDk.......",
    "..kHHHHkRkHHHHHHHHHHHHHHHHHHk.......",
    "..kHHHHRkHHHHHHHHHHHHHHHHHLHk.......",
    ".kTHHTkRTHHHTHHHHHHHHTHLLLLHDk......",
    ".kHHHDkkHHHTTHHHHHHHHDHLLLHHHk......",
    ".kHHHkkHHHDTHHHHHHHHHDHHHHHHHk......",
    ".kHHHkkHHHDTHSSSHLSSDSDHHHDHHk......",
    ".kHHHkkHHHDTHHHHDHHHDSDDDHHkHk......",
    ".kHHHkkHHkHHHHHDSLHDSSSTDHHkk.......",
    ".kHHHkkHHkHHHHDSSLHDSSkkkDHkk.......",
    ".kHHHkkHkkHHTkkkkkTSSSkLSDHk........",
    ".kHHHkkHkkkkkSkkSTTSSSDLSDHk........",
    ".kHHHkkkkkRLHSSDSSSSSSHLSDHkkkkk.kk.",
    "kkHHHkkkTkRLLSTHSSSSSSDLSDHkgggkkgk.",
    "kkHHHkk.TkRLHSDHSSSSSSLLSDTkgggkkgk.",
    "kkHHHkk.kkRHLSDDSSSSSSSSSDkkgggkgggk",
    "kkHHHkk..kHHLSSSSSSSSSSSSDkkggggggk.",
    "kkHHHkk...kkkCSSSSSSSSSSkkHkgggggk..",
    "kDHHHkk......kGGGGGGCkkkkHHkgggdk...",
    "kDHHHHkk...kRSSGGGGGCGSGkHHkldk.....",
    "kTHHHHkk..kCCCkGGGGGCGkkHkkWlk......",
    "kTHHHHkk.kkkkCCGGGGCkCkkkkWkDHHk....",
    "kTTHHHTkkkkkkkkCGGGkkkkkkWWDTHHk....",
    ".kkHHHHTkkkkkkkkCCCkkkDDkWkHHHHk....",
    ".kkHHHHTkkSkkkkkkkkkkkkkCkHHHHHk....",
    "...kHHHDk.kkkCCCCCCCCCCCkkHHHHHk....",
    "....kHHDk...kkkkkkkkkkkk..kTHHk.....",
    ".....kkk...kkkkk....kCkk...kkk......",
    "...........kkDk......kkk............",
    "...........kkDk......kkk............",
    "............kk......................",
]

PALETTE = {
    "k": (16, 30, 34),     # outline
    "H": (57, 197, 187),   # hair      #39c5bb
    "T": (28, 140, 145),   # hair shade
    "D": (14, 80, 92),     # dark strands / eyes
    "L": (170, 236, 230),  # hair shine / eye highlight
    "R": (225, 40, 133),   # hair ties / earpiece #e12885
    "S": (255, 228, 214),  # skin
    "G": (150, 162, 168),  # grey shirt
    "C": (32, 160, 170),   # teal tie / trim
    # leek
    "W": (246, 248, 236),  # white stalk
    "l": (178, 226, 120),  # light green
    "g": (92, 180, 70),    # green leaves
    "d": (52, 120, 48),    # dark green
}

# Kasane Teto: her own sprite (24x28) with coiled drill twintails and a baguette
TETO_PAL = {
    "k": (40, 16, 22), "H": (226, 66, 94), "T": (158, 30, 56), "L": (255, 150, 170),
    "S": (255, 230, 216), "s": (255, 170, 170), "E": (214, 30, 60), "e": (110, 10, 30),
    "W": (255, 255, 255), "G": (128, 120, 128), "g": (58, 50, 58), "R": (232, 44, 72),
    "B": (222, 160, 82), "b": (150, 88, 36), "C": (252, 222, 160),
}
BODY = [
    ".........kkkkkk",
    ".......kkHHHHHHkk",
    "......kHHHHLLHHHHk",
    ".....kHHHHHHLHHHHHk",
    "....kRHHHHHHHHHHHHRk",
    ".....kHHHHHHHHHHHHk",
    ".....kHHHTHHHHTHHHk",
    ".....kHHTkHHHHkTHHk",
    ".....kHTSSkHHkSSTHk",
    ".....kHSSSSSSSSSSHk",
    ".....kHSkkSSSSkkSHk",
    ".....kTSEeSSSSeESTk",
    ".....kTSEWSSSSWESTk",
    ".....kkSsSSSkSSsSkk",
    "......kkkSSSSSSkkk",
    "........kRRRRRRk",
    ".......kGGRRRRGGk",
    "......kGGGgRRgGGGk",
    "......kSkGgRRgGkSk",
    "......kSkGGgRgGGkSk",
    "......kkgggggggggkk",
    ".......kgggggggggk",
    ".......kgggggggggk",
    "........kSk...kSk",
    "........kgk...kgk",
    "........kkk...kkk",
]
BLINK = {10: ".....kHSSSSSSSSSSHk", 11: ".....kTSkkSSSSkkSTk", 12: ".....kTSSSSSSSSSSTk"}
# a coiled drill twintail, 6 wide, tapering to a point (left side; mirrored for the right)
DRILL = [
    ".kkkk.",
    "kHLHHk",
    "kHHHTk",
    "kTHHTk",
    ".kTTTk",
    "kHLHHk",
    "kHHHTk",
    "kTHTTk",
    ".kTTk.",
    ".kLHHk",
    ".kHHTk",
    "..kTTk",
    "..kLHk",
    "..kHTk",
    "...kTk",
    "...kk.",
]
W = 24

def paste(im, rows, ox, oy, mirror=False):
    for y, r in enumerate(rows):
        r = r[::-1] if mirror else r
        for x, c in enumerate(r):
            if c in TETO_PAL: im.putpixel((ox + x, oy + y), TETO_PAL[c] + (255,))

def baguette(im, x0, y0, x1, y1, r=1.6):
    """loaf from (x0,y0) to (x1,y1): dark crust edge, golden body, pale slashes"""
    L = math.hypot(x1 - x0, y1 - y0); ux, uy = (x1 - x0) / L, (y1 - y0) / L
    for y in range(im.height):
        for x in range(im.width):
            t = (x - x0) * ux + (y - y0) * uy
            if t < -r or t > L + r: continue
            tc = min(max(t, 0), L); d = math.hypot(x - (x0 + ux * tc), y - (y0 + uy * tc))
            if d > r + 0.9: continue
            if d > r: c = "k"
            else:
                side = (x - x0) * -uy + (y - y0) * ux   # >0 = underside
                c = "C" if int(t) % 4 == 1 and abs(side) < 1 else ("b" if side > 0.8 else "B")
            im.putpixel((x, y), TETO_PAL[c] + (255,))

def teto_art():
    rows = [r.ljust(W, ".") for r in BODY]
    art = Image.new("RGBA", (W, 28), (0, 0, 0, 0))
    paste(art, DRILL, 0, 4); paste(art, DRILL, W - 6, 4, mirror=True)
    paste(art, rows, 0, 0)
    baguette(art, 4, 25, 16, 18)
    return art.crop(art.getbbox())


def main():
    cw, ch, rows, out = int(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3]), sys.argv[4]
    teto = len(sys.argv) > 5 and sys.argv[5] == "teto"

    box_h = ch * rows
    if teto:
        art = teto_art()
    else:
        art = Image.new("RGBA", (len(SPRITE[0]), len(SPRITE)), (0, 0, 0, 0))
        for y, row in enumerate(SPRITE):
            for x, c in enumerate(row):
                if c in PALETTE:
                    art.putpixel((x, y), PALETTE[c] + (255,))
    w, h = art.size
    if box_h >= h:
        # crisp: integer nearest-neighbour upscale
        scale = box_h // h
        art = art.resize((w * scale, h * scale), Image.NEAREST)
    else:
        # box is shorter than the sprite: shrink smoothly so she stays recognisable
        art = art.resize((max(1, round(w * box_h / h)), box_h), Image.LANCZOS)
    cols = math.ceil(art.width / cw)
    img = Image.new("RGBA", (cols * cw, box_h), (0, 0, 0, 0))
    img.alpha_composite(art, ((cols * cw - art.width) // 2, (box_h - art.height) // 2))
    img.save(out)
    print(cols)


if __name__ == "__main__":
    main()
